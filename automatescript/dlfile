#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat << 'EOF'
Usage:
  dlfile [options]                              Interactive mode
  dlfile [options] <folder> <url> [filename]    Download into <folder>/<filename>
  dlfile [options] <url> [folder] [filename]    Auto-detect URL as 1st arg

Options:
  -F, --folder <dir>   Parent folder name
  -f, --file <name>    Output file name (default: <folder_basename>_file)
  -u, --url <url>      Download URL
  -x, --extract        Auto-extract after downloading (zip, tar.gz, gzip, tar, 7z)
  -y, --yes            Overwrite existing file without prompting
  -h, --help           Show this help message

Examples:
  dlfile
  dlfile wayback "https://..."
  dlfile -F wayback -u "https://..."
  dlfile -F wayback -f chall.zip -u "https://..." -x -y
EOF
}

strip_input() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    s="${s#\"}"
    s="${s%\"}"
    s="${s#\'}"
    s="${s%\'}"
    printf '%s' "$s"
}

extract=false
overwrite=false
flag_folder=""
flag_file=""
flag_url=""
args=()

while (( $# > 0 )); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -F|--folder)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires an argument." >&2; exit 1; }
            flag_folder="$2"
            shift 2
            ;;
        -f|--file)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires an argument." >&2; exit 1; }
            flag_file="$2"
            shift 2
            ;;
        -u|--url)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires an argument." >&2; exit 1; }
            flag_url="$2"
            shift 2
            ;;
        -x|--extract)
            extract=true
            shift
            ;;
        -y|--yes)
            overwrite=true
            shift
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

arg1="${args[0]:-}"
arg2="${args[1]:-}"
arg3="${args[2]:-}"

if [[ "$arg1" =~ ^https?:// ]]; then
    url="${flag_url:-$arg1}"
    folder="${flag_folder:-$arg2}"
    filename="${flag_file:-$arg3}"
else
    folder="${flag_folder:-$arg1}"
    url="${flag_url:-$arg2}"
    filename="${flag_file:-$arg3}"
fi

if [[ -z "$folder" ]]; then
    read -rp "Parent folder name: " folder
fi
folder="$(strip_input "$folder")"
folder="${folder%/}"

if [[ -z "$folder" || "$folder" =~ ^https?:// ]]; then
    echo "Error: Invalid parent folder name." >&2
    exit 1
fi

base_name="$(basename "$(realpath -m "$folder")")"
default_filename="${base_name}_file"

if [[ -z "$filename" && -z "$arg2" && ( -z "$flag_folder" || -z "$flag_url" ) ]]; then
    read -rp "File name [$default_filename]: " filename
fi
filename="$(strip_input "${filename:-$default_filename}")"
filename="${filename:-$default_filename}"

if [[ -z "$url" ]]; then
    read -rp "Download URL: " url
fi
url="$(strip_input "$url")"

if [[ -z "$url" ]]; then
    echo "Error: URL cannot be empty." >&2
    exit 1
fi

command -v curl >/dev/null 2>&1 || { echo "Error: 'curl' is not installed." >&2; exit 1; }
command -v file >/dev/null 2>&1 || { echo "Error: 'file' is not installed." >&2; exit 1; }

out="${folder}/${filename}"
if [[ -e "$out" && "$overwrite" != true ]]; then
    read -rp "File '${out}' already exists. Overwrite? [y/N]: " ans
    if [[ ! "$ans" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT

echo "[+] Downloading to ${out}..."
curl -LsS -f --connect-timeout 15 -o "$tmpfile" "$url"

mkdir -p "$folder"
mv -f "$tmpfile" "$out"

mime="$(file -b --mime-type "$out")"
echo "[+] Saved: ${out} ($(file -b "$out"))"

if [[ "$extract" == true ]]; then
    case "$mime" in
        application/zip)
            command -v unzip >/dev/null 2>&1 || { echo "Error: 'unzip' is not installed." >&2; exit 1; }
            echo "[+] Extracting zip..."
            unzip -o "$out" -d "$folder"
            ;;
        application/gzip|application/x-gzip)
            if tar -tzf "$out" >/dev/null 2>&1; then
                echo "[+] Extracting tar.gz..."
                tar -xzf "$out" -C "$folder"
            else
                echo "[+] Extracting gzip..."
                mv "$out" "${out}.gz" && gunzip -f "${out}.gz"
            fi
            ;;
        application/x-tar)
            echo "[+] Extracting tar..."
            tar -xf "$out" -C "$folder"
            ;;
        application/x-7z-compressed)
            command -v 7z >/dev/null 2>&1 || { echo "Error: '7z' is not installed." >&2; exit 1; }
            echo "[+] Extracting 7z..."
            7z x -y -o"$folder" "$out"
            ;;
        *)
            echo "[!] Not a supported archive format, skipping extraction."
            ;;
    esac
fi
